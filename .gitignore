# Python bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.env
.env.*
!.env.example

# IDE and editor settings
.idea/
.vscode/

# Test, coverage, and type-checker output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pytype/
.ruff_cache/

# Build and packaging output
build/
dist/
*.egg-info/

# Operating-system files
.DS_Store
Thumbs.db

# Large raw video files (exceed GitHub 100 MB limit)
*.mp4
*.mkv
*.mov
*.avi
*.webm
